<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Volas.Local.props" Condition="Exists('Volas.Local.props')" />

  <PropertyGroup>
    <GorillaTagDir Condition="'$(GorillaTagDir)' == '' and '$(VOLAS_GAME_DIR)' != ''">$(VOLAS_GAME_DIR)</GorillaTagDir>
    <GorillaTagDir Condition="'$(GorillaTagDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GorillaTagDir>
    <ManagedDir>$(GorillaTagDir)\Gorilla Tag_Data\Managed</ManagedDir>
    <BepInExDir>$(GorillaTagDir)\BepInEx\core</BepInExDir>
    <TargetFramework>net472</TargetFramework>
    <TargetFramework Condition="Exists('$(ManagedDir)\netstandard.dll')">netstandard2.1</TargetFramework>
    <TargetFramework Condition="'$(VolasTargetFramework)' != ''">$(VolasTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Volas</AssemblyName>
    <RootNamespace>Volas</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- All source folders compile into ONE Volas.dll, including GunLib and optional src. -->
  <ItemGroup>
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Features\**\*.cs" />
    <Compile Include="Game\**\*.cs" />
    <Compile Include="GunLib\**\*.cs" />
    <Compile Include="Settings\**\*.cs" />
    <Compile Include="UI\**\*.cs" />
    <Compile Include="src\**\*.cs" Condition="Exists('src')" />
  </ItemGroup>

  <!-- Unity versions move APIs between modules. Reference all game-local UnityEngine
       assemblies to resolve MonoBehaviour (CS0012) and module dependencies. -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ManagedDir)\UnityEngine*.dll">
      <Private>false</Private>
    </Reference>
    <!-- Legacy UnityEngine.dll can come from the BepInEx core on some installations. -->
    <Reference Include="UnityEngine" Condition="!Exists('$(ManagedDir)\UnityEngine.dll') and Exists('$(BepInExDir)\UnityEngine.dll')">
      <HintPath>$(BepInExDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Message Importance="high" Text="Volas: TargetFramework=$(TargetFramework); ManagedDir=$(ManagedDir)" />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')"
           Text="Volas: UnityEngine.CoreModule.dll not found in $(ManagedDir). Run build.bat or set GorillaTagDir to your PC Gorilla Tag folder." />
    <Error Condition="!Exists('$(BepInExDir)\BepInEx.dll')"
           Text="Volas: BepInEx.dll not found in $(BepInExDir). Install BepInEx 5 Mono for PC Gorilla Tag." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.IMGUIModule.dll')"
           Text="Volas: UnityEngine.IMGUIModule.dll missing in $(ManagedDir)." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.PhysicsModule.dll')"
           Text="Volas: UnityEngine.PhysicsModule.dll missing in $(ManagedDir)." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.XRModule.dll')"
           Text="Volas: UnityEngine.XRModule.dll missing in $(ManagedDir)." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.InputLegacyModule.dll')"
           Text="Volas: UnityEngine.InputLegacyModule.dll missing in $(ManagedDir)." />
  </Target>

  <Target Name="InstallVolas" AfterTargets="Build" Condition="'$(InstallToGame)' == 'true'">
    <MakeDir Directories="$(GorillaTagDir)\BepInEx\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GorillaTagDir)\BepInEx\plugins" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Volas installed at $(GorillaTagDir)\BepInEx\plugins\Volas.dll" />
  </Target>
</Project>
