<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Volas.Local.props" Condition="Exists('Volas.Local.props')" />

  <PropertyGroup>
    <GorillaTagDir Condition="'$(GorillaTagDir)' == '' and '$(VOLAS_GAME_DIR)' != ''">$(VOLAS_GAME_DIR)</GorillaTagDir>
    <GorillaTagDir Condition="'$(GorillaTagDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GorillaTagDir>
    <ManagedDir>$(GorillaTagDir)\Gorilla Tag_Data\Managed</ManagedDir>
    <BepInExDir>$(GorillaTagDir)\BepInEx\core</BepInExDir>
    <UnityEngineFacadePath Condition="'$(UnityEngineFacadePath)' == '' and '$(VOLAS_UNITYENGINE_DLL)' != ''">$(VOLAS_UNITYENGINE_DLL)</UnityEngineFacadePath>
    <UnityEngineFacadePath Condition="'$(UnityEngineFacadePath)' == '' and Exists('$(ManagedDir)\UnityEngine.dll')">$(ManagedDir)\UnityEngine.dll</UnityEngineFacadePath>
    <UnityEngineFacadePath Condition="'$(UnityEngineFacadePath)' == '' and Exists('$(BepInExDir)\UnityEngine.dll')">$(BepInExDir)\UnityEngine.dll</UnityEngineFacadePath>
    <UnityEngineFacadePath Condition="'$(UnityEngineFacadePath)' == '' and Exists('$(GorillaTagDir)\BepInEx\plugins\UnityEngine.dll')">$(GorillaTagDir)\BepInEx\plugins\UnityEngine.dll</UnityEngineFacadePath>
    <!-- BepInEx 5 Mono normally works with .NET Framework.  Do NOT infer
         netstandard2.1 only because Unity ships a netstandard facade. -->
    <TargetFramework>net472</TargetFramework>
    <TargetFramework Condition="'$(VolasTargetFramework)' != ''">$(VolasTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Volas</AssemblyName>
    <RootNamespace>Volas</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <NoWarn>$(NoWarn);1701</NoWarn>
  </PropertyGroup>

  <!-- Every source folder compiles into the same Volas.dll. -->
  <ItemGroup>
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Features\**\*.cs" />
    <Compile Include="Game\**\*.cs" />
    <Compile Include="GunLib\**\*.cs" />
    <Compile Include="Settings\**\*.cs" />
    <Compile Include="UI\**\*.cs" />
    <Compile Include="src\**\*.cs" Condition="Exists('src')" />
  </ItemGroup>

  <!-- Use explicit reference assembly names and HintPaths.  The previous
       wildcard-only <Reference Include="...UnityEngine*.dll"> left MonoBehaviour
       unresolved in Visual Studio (CS0012).  Do not redistribute these DLLs. -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <!-- Resolve UnityEngine.dll explicitly. BepInEx builds that reference the
         UnityEngine facade produce repeated CS0012 MonoBehaviour errors if it
         is silently omitted by a conditional reference. -->
    <Reference Include="UnityEngine">
      <HintPath Condition="'$(UnityEngineFacadePath)' != ''">$(UnityEngineFacadePath)</HintPath>
      <HintPath Condition="'$(UnityEngineFacadePath)' == ''">$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.XRModule">
      <HintPath>$(ManagedDir)\UnityEngine.XRModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule" Condition="Exists('$(ManagedDir)\UnityEngine.AnimationModule.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule" Condition="Exists('$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateVolasReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="Volas compiling $(TargetFramework) against: $(ManagedDir)" />
    <Message Importance="high" Text="UnityEngine.dll facade: $(UnityEngineFacadePath)" />
    <Error Condition="'$(UnityEngineFacadePath)' == ''"
           Text="Volas: UnityEngine.dll was not found. Run build.bat -GamePath &quot;YOUR_GAME_PATH&quot; or supply -UnityEngineFacadePath with the matching UnityEngine.dll. CoreModule alone does not resolve CS0012 for older BepInEx." />
    <Error Condition="'$(UnityEngineFacadePath)' != '' and !Exists('$(UnityEngineFacadePath)')"
           Text="Volas: UnityEngineFacadePath points to a missing DLL: $(UnityEngineFacadePath)" />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')"
           Text="Volas: UnityEngine.CoreModule.dll missing at $(ManagedDir). Run build.bat with -GamePath or check Steam's installed game directory." />
    <Error Condition="!Exists('$(BepInExDir)\BepInEx.dll')"
           Text="Volas: BepInEx 5 Mono not installed at $(BepInExDir). Check Gorilla Tag's game folder." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.IMGUIModule.dll')"
           Text="Volas: UnityEngine.IMGUIModule.dll missing at $(ManagedDir)." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.UI.dll')"
           Text="Volas uGUI requires UnityEngine.UI.dll in the game Managed folder." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.UIModule.dll')"
           Text="Volas uGUI requires UnityEngine.UIModule.dll in the game Managed folder." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.InputLegacyModule.dll')"
           Text="Volas: UnityEngine.InputLegacyModule.dll missing at $(ManagedDir)." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.PhysicsModule.dll')"
           Text="Volas: UnityEngine.PhysicsModule.dll missing at $(ManagedDir)." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.XRModule.dll')"
           Text="Volas: UnityEngine.XRModule.dll missing at $(ManagedDir)." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.TextRenderingModule.dll')"
           Text="Volas: UnityEngine.TextRenderingModule.dll missing at $(ManagedDir)." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.AudioModule.dll')"
           Text="Volas: UnityEngine.AudioModule.dll missing at $(ManagedDir)." />
  </Target>

  <Target Name="InstallVolas" AfterTargets="Build" Condition="'$(InstallToGame)' == 'true'">
    <MakeDir Directories="$(GorillaTagDir)\BepInEx\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GorillaTagDir)\BepInEx\plugins" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Installed Volas.dll to $(GorillaTagDir)\BepInEx\plugins" />
  </Target>
</Project>
